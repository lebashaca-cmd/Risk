# Where the website listens. Most hosts set PORT for you.
PORT=8080

# The bot's public status page (the one main.py serves). Used for the live badge.
BOT_STATUS_URL=https://uison65lds.apps.bot-hosting.cloud/status

# Builds the "Add Risk to your server" link. This is the bot's application ID, not its token.
CLIENT_ID=1557594467551412356

# Optional
# INVITE_URL=https://discord.com/oauth2/authorize?client_id=...
# INVITE_PERMISSIONS=
# SUPPORT_URL=https://discord.gg/your-invite
# SITE_NAME=Risk

# Set to 1 when the site sits behind a proxy (Render, Railway, nginx) so rate limits see real visitor IPs.
TRUST_PROXY=0
